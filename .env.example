# Gmail Connect (F09) — separate from NextAuth GOOGLE_CLIENT_ID
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# 32-byte hex (64 characters). Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Storage (required for statement / invoice upload)
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
# Or: AWS_S3_DOCUMENTS_BUCKET=muneem-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional local MinIO: S3_ENDPOINT=http://localhost:9000

